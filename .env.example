# Configuration Firebase de l'application web.
#
# Ces valeurs ne sont PAS des secrets : elles partent dans le navigateur de chaque
# visiteur, c'est ainsi que Firebase fonctionne. Ce qui protège les données, ce sont
# les règles de sécurité (firestore.rules), pas la confidentialité de ces clés.
#
# En revanche, une clé de compte de service (fichier JSON avec « private_key ») ne
# doit JAMAIS être copiée ici, ni dans le dépôt, ni dans une conversation.
#
# Les valeurs du projet sont déjà dans src/lib/data/firestore/options.ts : l'application
# fonctionne sans ce fichier. Ne le créer que pour pointer vers un AUTRE projet Firebase
# (une préproduction, par exemple). Chaque ligne renseignée l'emporte sur options.ts.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mettre 1 pour brancher l'application sur les émulateurs locaux plutôt que sur le
# vrai projet. Laisser vide en production.
VITE_USE_EMULATORS=

# Source de données : « mock » pour l'écran de démonstration, « firestore » pour de vrai.
VITE_DATA_SOURCE=mock
