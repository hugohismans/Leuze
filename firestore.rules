rules_version = '2';

// Règles de sécurité Firestore — hôpital Saint-Jean-de-Dieu, Leuze-en-Hainaut.
//
// Trois invariants que ces règles doivent garantir, et que les tests de `tests/rules/`
// vérifient un par un :
//   1. Un patient ne reçoit jamais une activité réservée à un autre service — pas même
//      son titre. Le filtre par service vit ici, pas dans l'interface.
//   2. Un patient ne lit jamais l'inscription de quelqu'un d'autre, ni la liste des
//      inscrits d'une activité.
//   3. Aucune écriture client sur `registrations` ni `patients` : la capacité et la liste
//      d'attente ne sont modifiées que par une transaction de Cloud Function.
//   4. Un réglage particulier accordé à quelqu'un n'est lu que par lui et par le
//      personnel, et n'est écrit que par l'administrateur : une exception est une
//      décision de service.
//   5. Une idée d'activité déposée par un patient n'est lue que par lui et par
//      l'administrateur, et aucune ne s'écrit depuis un navigateur : la longueur des
//      textes et la limite d'une seule idée en attente ne peuvent se vérifier que dans
//      une fonction appelable — une règle Firestore ne sait pas compter les documents
//      d'une collection.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- identité -------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(name) {
      return signedIn() && 'role' in request.auth.token && request.auth.token.role == name;
    }

    function isStaff() {
      return hasRole('staff') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Le patient reçoit un jeton personnalisé en échange de son code court.
    // Son service est porté par le jeton : il n'est donc pas modifiable côté client.
    function isPatient() {
      return signedIn() && 'patient' in request.auth.token && request.auth.token.patient == true;
    }

    function patientService() {
      return 'serviceId' in request.auth.token ? request.auth.token.serviceId : '';
    }

    // L'intervenant auquel un compte du personnel est relié. Posé dans le jeton par
    // `setStaffRole` et `createStaffAccount` : c'est lui qui décide de l'agenda, jamais
    // un document. Chaîne vide quand le compte n'est relié à personne — et une chaîne
    // vide ne peut alors être égale à aucun `practitionerId`, qui est toujours renseigné.
    function myPractitioner() {
      return 'practitionerId' in request.auth.token ? request.auth.token.practitionerId : '';
    }

    // L'activité est la mienne : c'est moi qui l'anime.
    function mineAsFacilitator(data) {
      return myPractitioner() != ''
        && 'facilitatorId' in data
        && data.facilitatorId == myPractitioner();
    }

    // Le rendez-vous me concerne : c'est moi qu'on vient voir.
    function mineAsPractitioner(data) {
      return myPractitioner() != ''
        && 'practitionerId' in data
        && data.practitionerId == myPractitioner();
    }

    // --- catalogue ------------------------------------------------------------
    // Lieux, catégories et services : lisibles par toute personne connectée (les noms
    // des unités sont publics, ils figurent sur le site de l'établissement).
    // Modifiables par l'administrateur, y compris pour ajouter un lieu ou un service.

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /**
     * Les intervenants : psychiatre, kinésithérapeute, animateur.
     *
     * Lisibles par tous ceux qui sont connectés, patients compris : leur nom figure déjà
     * sur les activités et les rendez-vous, il n'y a rien de plus à cacher ici. Ce n'est
     * pas un compte — personne ne se connecte avec ceci, et rien de ce qui est écrit là
     * ne donne le moindre droit.
     */
    // Les plages où quelqu'un reçoit : un jour, deux heures. Rien d'autre ne s'y écrit.
    function validAvailability(windows) {
      return windows is list && windows.size() <= 20;
    }

    // Une personne du personnel tient ses propres disponibilités à jour — elle seule sait
    // quand elle est là. Elle ne touche à rien d'autre de sa fiche : ni son nom, ni sa
    // fonction, ni le fait qu'elle soit encore en poste.
    // L'identifiant vient du chemin : une fonction ne voit pas le joker du bloc `match`,
    // il lui est donc passé.
    function myOwnAvailability(id) {
      return id == myPractitioner()
        && myPractitioner() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'autoAccept'])
        && (!('availability' in request.resource.data) || validAvailability(request.resource.data.availability))
        && (!('autoAccept' in request.resource.data) || request.resource.data.autoAccept is bool);
    }

    match /practitioners/{practitionerId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && myOwnAvailability(practitionerId));
    }

    match /config/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- activités ------------------------------------------------------------
    // Réservées au personnel : le patient n'en a pas besoin, tout ce qu'il doit voir
    // est dénormalisé sur l'occurrence. Moins de surface, moins de fuites.

    function validAudience(data) {
      return data.audience in ['all', 'services']
        && data.serviceIds is list
        && (data.audience == 'all' ? data.serviceIds.size() == 0 : true);
    }

    function validActivity(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.categoryId is string
        && data.locationId is string
        && (data.capacity == null || (data.capacity is int && data.capacity >= 0))
        && data.registrationRequired is bool
        && data.waitlistEnabled is bool
        && data.isActive is bool
        && validAudience(data);
    }

    // Le programme est un calendrier partagé, affiché au mur de l'unité : tout le
    // personnel le lit. Le modifier est autre chose — un soignant crée des activités,
    // mais ce sont les siennes : il les anime. Désigner quelqu'un d'autre relève de
    // l'organisation du service, donc de l'administrateur.
    //
    // Reprendre l'activité d'un collègue reviendrait à la lui retirer ; et une activité
    // que personne n'anime n'appartient à personne en particulier. Les deux sont donc
    // laissées à l'administrateur.
    match /activities/{activityId} {
      allow read: if isStaff();
      allow create: if (isAdmin() && validActivity(request.resource.data))
        || (isStaff()
            && validActivity(request.resource.data)
            && mineAsFacilitator(request.resource.data));
      allow update: if (isAdmin() && validActivity(request.resource.data))
        || (isStaff()
            && validActivity(request.resource.data)
            && mineAsFacilitator(resource.data)
            && mineAsFacilitator(request.resource.data));
      // Jamais de suppression physique : une activité se désactive (`isActive: false`).
      allow delete: if false;
    }

    // --- occurrences ----------------------------------------------------------

    function visibleToPatient() {
      return resource.data.audienceKeys.hasAny(['all', patientService()]);
    }

    // Ce qu'un soignant peut modifier directement sur une occurrence isolée :
    // l'annuler, la déplacer de salle. Ni les compteurs, ni l'audience, ni l'horaire
    // (changer l'horaire change l'identifiant déterministe : cela passe par une
    // Cloud Function, qui recrée l'occurrence et déplace les inscriptions).
    function staffOccurrencePatch() {
      // `hasOnly` protège d'un seul coup les compteurs, l'audience, l'horaire et tout
      // champ futur : ce qui n'est pas dans cette liste ne peut pas bouger.
      // Note : sur un refus, l'émulateur journalise « evaluation error » avant de
      // conclure au refus. Le refus est bien le résultat — les tests le vérifient,
      // ainsi que le fait qu'une annulation légitime, elle, passe.
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancellationReason', 'locationId', 'overridden', 'autoCancelled', 'cancelledByLeave'])
        && request.resource.data.status in ['scheduled', 'cancelled', 'moved'];
    }

    // Une occurrence fraîchement engendrée ne porte aucune inscription : les compteurs
    // partent à zéro. C'est vrai que la génération vienne d'une Cloud Function ou, sur
    // le plan gratuit, de l'application soignante elle-même.
    function validNewOccurrence(data) {
      return data.activityId is string
        && data.localDate is string
        && data.audienceKeys is list
        && data.status in ['scheduled', 'cancelled', 'moved']
        && data.confirmedCount == 0
        && data.waitlistCount == 0;
    }

    // Régénération d'une série : tout peut bouger sauf les compteurs, qui appartiennent
    // aux inscriptions et à elles seules.
    function staffOccurrenceRegeneration() {
      return request.resource.data.confirmedCount == resource.data.confirmedCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.status in ['scheduled', 'cancelled', 'moved'];
    }

    match /occurrences/{occurrenceId} {
      // `list` est soumis à la même condition : une requête qui ne filtre pas sur
      // `audienceKeys` est refusée en bloc, elle ne renvoie pas un sous-ensemble.
      allow get, list: if isStaff() || (isPatient() && visibleToPatient());

      /*
        Écrire une séance, c'est modifier l'activité de quelqu'un.

        `mineAsFacilitator` manquait ici, et lui seul. Le document de l'activité était
        bien protégé — un intervenant ne modifie que celles qu'il anime — mais ses séances
        ne l'étaient pas : n'importe quel membre du personnel pouvait annuler la séance
        d'un collègue, et donc vider son activité du programme sans jamais toucher à
        l'activité elle-même. Constaté en service.

        Une activité sans animateur désigné n'appartient à personne en particulier : elle
        relève de l'organisation du service, donc de l'administrateur. C'est exactement ce
        que dit `canEditActivity` côté domaine, et les deux doivent dire la même chose.
      */
      allow create: if validNewOccurrence(request.resource.data)
        && (isAdmin() || (isStaff() && mineAsFacilitator(request.resource.data)));
      allow update: if (staffOccurrencePatch() || staffOccurrenceRegeneration())
        && (isAdmin()
            || (isStaff()
                && mineAsFacilitator(resource.data)
                && mineAsFacilitator(request.resource.data)));
      // Une occurrence portant des inscriptions ne se supprime jamais : elle s'annule.
      allow delete: if resource.data.confirmedCount == 0
        && resource.data.waitlistCount == 0
        && (isAdmin() || (isStaff() && mineAsFacilitator(resource.data)));
    }

    // --- inscriptions ---------------------------------------------------------
    // Aucune écriture client : tout passe par les callables `register` / `unregister`,
    // qui exécutent une transaction. Sans cela, deux patients pourraient confirmer
    // la même dernière place.

    match /registrations/{registrationId} {
      /**
       * Un patient lit les siennes, et personne d'autre ne lit rien ici.
       *
       * Le personnel passait par cette porte jusqu'à ce que l'appel existe. Depuis, une
       * inscription porte aussi la présence — qui est venu, qui ne l'est pas — et cela
       * n'appartient qu'à la personne qui anime l'activité. Le personnel obtient donc
       * ses listes par des fonctions appelables, qui savent à qui elles parlent : voir
       * `staffRoster`. Aucun écran client n'a besoin de cette collection.
       */
      allow get, list: if isPatient() && resource.data.patientUid == request.auth.uid;
      allow write: if false;
    }

    // --- rendez-vous individuels ----------------------------------------------
    // Un patient demande à voir quelqu'un ; un soignant fixe la date. Aucun champ
    // libre nulle part : le motif de rendez-vous est déjà sensible, un texte libre
    // à côté deviendrait le réceptacle de contenu clinique.

    match /appointmentKinds/{kindId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /*
      La demande d'un patient ne passe plus par le navigateur.

      Décider si une place est libre suppose de lire l'agenda d'un intervenant — ce qu'un
      patient ne verra jamais. La demande est donc portée par une fonction appelable, qui
      écrit avec les droits du serveur : le client n'a plus rien à créer ici.
    */

    /**
     * Un soignant fixe un rendez-vous sans demande préalable.
     *
     * Beaucoup de patients ne se serviront jamais de l'application : ils demandent leur
     * rendez-vous de vive voix. Le refuser reviendrait à réserver l'agenda à ceux qui ont
     * un téléphone. Le rendez-vous est donc créé déjà fixé, par le personnel.
     *
     * `hasOnly` ferme la porte à tout champ imprévu : c'est ce qui empêche qu'un texte
     * libre — donc du contenu clinique — s'installe un jour ici.
     */
    /*
      Un rendez-vous concerne un patient d'ici, ou une personne extérieure — jamais les
      deux, jamais aucun.

      Certains soignants reçoivent des gens qui ne sont plus hospitalisés : d'anciens
      patients, le plus souvent. Ces rendez-vous occupent une vraie place dans un agenda,
      et les tenir hors de l'application, c'est proposer des créneaux déjà pris.

      « Un prénom » et non « un nom » : soixante caractères, la même discipline que pour
      un patient d'ici, dont l'application n'enregistre jamais que le prénom.
    */
    function unePersonneOuLAutre(data) {
      return (('patientUid' in data) != ('externalName' in data))
        && (!('patientUid' in data) || (data.patientUid is string && data.patientUid.size() > 0))
        && (!('externalName' in data)
            || (data.externalName is string
                && data.externalName.size() > 0
                && data.externalName.size() <= 60));
    }

    function validStaffAppointment(data) {
      return data.keys().hasOnly([
          'patientUid', 'externalName', 'kindId', 'preference', 'status',
          'createdAt', 'start', 'end', 'localDate', 'withWhom', 'locationId', 'practitionerId'
        ])
        && unePersonneOuLAutre(data)
        && data.kindId is string && data.kindId.size() > 0
        && data.preference in ['matin', 'apres-midi', 'peu-importe']
        && data.status == 'scheduled'
        && data.withWhom is string && data.withWhom.size() > 0
        && data.localDate is string && data.localDate.size() == 10
        && data.start is timestamp && data.end is timestamp;
    }

    // Le patient peut retirer sa demande tant qu'elle n'est pas fixée. Il ne peut
    // pas la transformer en autre chose : ni changer de patient, ni la programmer.
    function patientWithdrawal() {
      return ('patientUid' in resource.data)
        && resource.data.patientUid == request.auth.uid
        && resource.data.status == 'requested'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.kindId == resource.data.kindId
        && !('start' in request.resource.data)
        && !('withWhom' in request.resource.data);
    }

    // Un rendez-vous ne dit pas pourquoi — le projet s'y refuse — mais il dit avec qui,
    // et « avec le psychiatre » en apprend déjà beaucoup sur quelqu'un. La liste entière
    // n'a donc rien à faire sous les yeux de toute l'équipe.
    //
    // Un intervenant lit son agenda et lui seul ; il n'écrit que des rendez-vous où c'est
    // lui qu'on vient voir. L'administrateur voit tout et répartit — quelqu'un doit
    // pouvoir le faire, et une demande en attente ne nomme encore personne.
    match /appointments/{appointmentId} {
      allow get, list: if isAdmin()
        || (isStaff() && mineAsPractitioner(resource.data))
        // « 'patientUid' in » d'abord : un rendez-vous avec une personne extérieure n'en
        // porte pas, et la comparaison seule ferait échouer la règle au lieu de refuser.
        || (isPatient()
            && ('patientUid' in resource.data)
            && resource.data.patientUid == request.auth.uid);
      allow create: if (isAdmin() && validStaffAppointment(request.resource.data))
        || (isStaff()
            && validStaffAppointment(request.resource.data)
            && mineAsPractitioner(request.resource.data));
      // Un intervenant ne s'attribue pas le rendez-vous d'un autre, et ne se retire pas
      // le sien : la personne nommée est la même avant et après.
      allow update: if isAdmin()
        || (isStaff()
            && mineAsPractitioner(resource.data)
            && mineAsPractitioner(request.resource.data))
        || (isPatient() && patientWithdrawal());
      // Un rendez-vous ne se supprime pas : il s'annule, avec un motif.
      allow delete: if false;
    }

    // --- réglages particuliers d'une personne ----------------------------------
    //
    // Ce qu'une personne peut faire quand cela diffère de la règle du service : quatre
    // booléens, rien d'autre. Aucun nom, aucune date, rien de clinique — l'identifiant du
    // document est celui du compte.
    //
    // Chacun lit le sien : son écran s'en sert pour ne pas proposer un geste qui serait
    // refusé, et pour dire ce qu'il faut faire à la place. Le personnel lit tout — c'est
    // lui qui voit la fiche. Seul l'administrateur écrit : une exception accordée à
    // quelqu'un est une décision de service, pas un arrangement de couloir.
    match /patientActions/{patientUid} {
      allow get: if isStaff() || (isPatient() && request.auth.uid == patientUid);
      allow list: if isStaff();
      allow write: if isAdmin();
    }

    // --- idées des patients ---------------------------------------------------
    //
    // Une proposition d'activité : un titre, une description, et le fait que la personne
    // se propose ou non de l'animer. Ce n'est pas un message à un soignant, et cela ne
    // doit jamais le devenir — d'où deux précautions ici.
    //
    // **Aucune écriture cliente.** Déposer une idée passe par une fonction appelable, qui
    // vérifie la longueur des textes et qu'une seule idée attend à la fois. Un navigateur
    // qui pourrait écrire ici pourrait écrire un texte de dix mille caractères, ou dix
    // idées d'affilée, et la file cesserait d'être lue.
    //
    // **Chacun ne lit que les siennes.** Une idée porte le prénom de qui l'a proposée :
    // la laisser lire aux autres patients reviendrait à publier qui demande quoi.
    // L'administrateur, lui, lit tout — c'est lui qui répond.
    match /proposals/{proposalId} {
      allow get, list: if isAdmin()
        || (isPatient() && resource.data.patientUid == request.auth.uid);
      allow write: if false;
    }

    // --- patients -------------------------------------------------------------
    // Prénom, service, dates. L'identifiant du document est le hachage du code d'accès.
    // Rien de tout cela n'est lisible par un client, y compris par le personnel :
    // les listes d'inscrits sont servies par une Cloud Function.

    match /patients/{patientId} {
      allow read, write: if false;
    }

    // --- congés du personnel --------------------------------------------------
    //
    // À part du document « practitioners/ », et pour une raison de lecture : les
    // intervenants sont lisibles par toute personne connectée, patients compris, parce
    // que le patient lit leur nom. Les dates d'absence de quelqu'un n'ont rien à y faire.
    //
    // L'écriture passe par une fonction appelable : déclarer un congé rouvre les
    // rendez-vous déjà fixés sur ces jours-là, et deux écritures qui doivent tenir
    // ensemble ne se confient pas au navigateur.
    match /leaves/{practitionerId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // --- comptes du personnel -------------------------------------------------
    // Le rôle qui fait autorité est le « custom claim » du jeton, posé par une
    // Cloud Function. Ce document ne sert qu'à l'affichage (prénom, actif ou non).

    match /staff/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- refus par défaut -----------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
