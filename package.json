{
  "name": "leuze-activites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_DATA_SOURCE=mock vite",
    "build": "VITE_DATA_SOURCE=mock vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "seed": "vite-node scripts/seed.ts",
    "test:rules": "firebase emulators:exec --project demo-leuze --only firestore \"vitest run -c vitest.rules.config.ts\"",
    "test:backend": "firebase emulators:exec --project demo-leuze --only firestore \"vitest run -c vitest.backend.config.ts\"",
    "check:functions": "npm --prefix functions run check",
    "promote:admin": "vite-node scripts/promote-admin.ts",
    "dev:firestore": "VITE_DATA_SOURCE=firestore VITE_USE_EMULATORS=1 vite",
    "build:demo": "VITE_DATA_SOURCE=mock vite build",
    "deploy:demo": "npm run build && firebase deploy --only hosting",
    "deploy:regles": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:fonctions": "bash scripts/deploy-fonctions.sh",
    "init:catalogue": "vite-node scripts/init-catalogue.ts",
    "build:app": "VITE_DATA_SOURCE=firestore vite build",
    "deploy:app": "npm run build:app && firebase deploy --only hosting",
    "journal": "firebase functions:log --project leuze-d23b5 -n 40",
    "ouvrir:fonctions": "bash scripts/ouvrir-fonctions.sh",
    "autoriser:jetons": "bash scripts/autoriser-jetons.sh"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.18.0"
  }
}
